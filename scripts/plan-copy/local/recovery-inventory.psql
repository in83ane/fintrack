-- OPERATOR-RUN READ-ONLY INVENTORY. No resume, reset, cleanup or marker changes.
-- Not part of the bootstrap manifest. Output contains metadata/counts, not rows.
\set ON_ERROR_STOP on
\set VERBOSITY terse
\encoding UTF8
\pset pager off
BEGIN TRANSACTION ISOLATION LEVEL REPEATABLE READ READ ONLY;
SET LOCAL statement_timeout='15s';
SET LOCAL lock_timeout='3s';
SET LOCAL search_path=pg_catalog;
SELECT current_database()='fintrack_local_test'
 AND inet_server_addr() IS NOT DISTINCT FROM '127.0.0.1'::inet
 AND inet_server_port() IS NOT DISTINCT FROM 5432
 AND current_setting('server_version_num')::int BETWEEN 180000 AND 189999 AS target_ok
\gset
\if :target_ok
\echo VERIFIED_LOCAL_TARGET_READ_ONLY
\else
\echo STOP_LOCAL_ENDPOINT_OR_VERSION_MISMATCH
ROLLBACK;
\quit 3
\endif
SELECT current_database() AS database,current_setting('server_version') AS server_version,
 inet_server_addr() AS server_address,inet_server_port() AS server_port,
 current_setting('transaction_read_only') AS read_only,
 pg_get_userbyid(datdba) AS database_owner
FROM pg_database WHERE datname=current_database();

SELECT extname,extversion FROM pg_extension ORDER BY extname;
SELECT n.nspname,c.relname,c.relkind,pg_get_userbyid(c.relowner) AS owner,c.relrowsecurity
FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname IN ('public','auth','plan_copy_guard','plan_private','bucket_private','cron','net','vault')
 AND c.relkind IN ('r','p','v','m','f') ORDER BY 1,2;

-- Only base-table counts in known bootstrap schemas, no user row contents.
-- Identifiers are quoted by format(%I); no client-supplied SQL is evaluated.
SELECT format('SELECT %L AS object, count(*) AS row_count FROM %I.%I;',
 n.nspname||'.'||c.relname,n.nspname,c.relname)
FROM pg_class c JOIN pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname IN ('public','auth','plan_copy_guard','plan_private','bucket_private')
 AND c.relkind IN ('r','p') ORDER BY n.nspname,c.relname
\gexec

SELECT to_regclass('plan_copy_guard.applied') IS NOT NULL AS has_applied
\gset
\if :has_applied
SELECT ordinal,path,sha256 FROM plan_copy_guard.applied ORDER BY ordinal;
\endif

SELECT to_regclass('plan_copy_guard.bootstrap') IS NOT NULL AS has_bootstrap
\gset
\if :has_bootstrap
SELECT environment,manifest_sha256,server_major,purpose FROM plan_copy_guard.bootstrap;
\endif

SELECT rolname,rolcanlogin,rolsuper,rolbypassrls,rolcreatedb,rolcreaterole,rolreplication
FROM pg_roles WHERE rolname IN ('fintrack_local_owner','fintrack_tester','anon','authenticated','service_role')
ORDER BY rolname;
SELECT parent.rolname AS parent,child.rolname AS member,m.admin_option,m.inherit_option,m.set_option
FROM pg_auth_members m JOIN pg_roles parent ON parent.oid=m.roleid JOIN pg_roles child ON child.oid=m.member
WHERE child.rolname IN ('fintrack_tester','authenticated','anon','service_role','fintrack_local_owner')
ORDER BY 1,2;
ROLLBACK;
\echo READ_ONLY_INVENTORY_COMPLETE_NO_DATABASE_CHANGES
